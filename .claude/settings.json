{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(flatpak run org.flatpak.Builder *)",
      "Bash(just *-e2e *)",
      "Bash(sudo *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git push --force*)",
      "Bash(sudo fisherman *)",
      "Bash(sudo */fisherman *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*recovery-key*)",
      "Read(./**/*recovery_key*)"
    ]
  }
}
